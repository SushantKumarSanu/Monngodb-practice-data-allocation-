<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Create User</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-gradient-to-b from-slate-50 to-slate-100 flex items-center justify-center p-6">
  <main class="w-full max-w-3xl bg-white/80 backdrop-blur-sm rounded-2xl shadow-lg ring-1 ring-slate-200 p-8">
    <div class="sm:flex sm:items-center sm:justify-between mb-6">
      <div>
        <h1 class="text-2xl font-semibold text-slate-800">Create User</h1>
        <p class="mt-1 text-sm text-slate-500">Add a new user to the system</p>
      </div>
      <div class="mt-4 sm:mt-0">
        <span class="inline-flex items-center rounded-full bg-sky-100 text-sky-800 px-3 py-1 text-xs font-medium">New</span>
      </div>
    </div>

    <form action="/create" method="POST" class="space-y-6">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">

        <div>
          <label for="name" class="block text-sm font-medium text-slate-700 mb-1">Full name</label>
          <input id="name" name="name" type="text" placeholder="Sushant Kumar"
                 class="w-full rounded-lg border border-slate-200 px-4 py-2 bg-white text-sm placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-sky-300" />
        </div>
            

        <div>
          <label for="email" class="block text-sm font-medium text-slate-700 mb-1">Email address</label>
          <input id="email" name="email" type="email" placeholder="you@example.com"
                 class="w-full rounded-lg border border-slate-200 px-4 py-2 bg-white text-sm placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-sky-300" />
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="password" class="block text-sm font-medium text-slate-700 mb-1">Password</label>
          <input id="password" name="password" type="password" placeholder="Enter a secure password"
                 class="w-full rounded-lg border border-slate-200 px-4 py-2 bg-white text-sm placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-sky-300" />
        </div>
         <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="age" class="block text-sm font-medium text-slate-700 mb-1">Age</label>
          <input id="age" name="age" type="text" placeholder="Enter your age"
                 class="w-full rounded-lg border border-slate-200 px-4 py-2 bg-white text-sm placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-sky-300" />
        </div>
      </div>

       <div class="flex items-center justify-between gap-4">
        <button type="submit"
                class="ml-auto inline-flex items-center rounded-full bg-sky-600 text-white px-6 py-2 text-sm font-semibold hover:bg-sky-700 focus:outline-none focus:ring-2 focus:ring-sky-300">
          Create User
        </button>
      </div>
    </form>
  </main>
</body>
</html>